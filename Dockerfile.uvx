# Builds the architecture-independent uvx package.
#
# uvx is a small trampoline that execs the uv binary sitting next to it -- it
# does not search PATH -- so it can only live in /usr/bin alongside /usr/bin/uv,
# which is exactly where the uv package already installs it. This package
# therefore ships no executable of its own; it makes "apt install uvx" resolve
# and pulls in uv. Same base image for every distribution, as with the uv
# packages: the payload is arch- and distro-independent metadata only.
FROM debian:bookworm

ARG DIST
ARG uv_VERSION
ARG BUILD_VERSION
ARG FULL_VERSION
ARG DEB_NAME

RUN mkdir -p /output/usr/share/doc/uvx
RUN mkdir -p /output/DEBIAN

COPY output/uvx/DEBIAN/control /output/DEBIAN/
COPY output/copyright /output/usr/share/doc/uvx/
COPY output/uvx/changelog.Debian /output/usr/share/doc/uvx/

RUN sed -i "s/DIST/$DIST/g" /output/usr/share/doc/uvx/changelog.Debian
RUN sed -i "s/FULL_VERSION/$FULL_VERSION/g" /output/usr/share/doc/uvx/changelog.Debian
RUN sed -i "s/DIST/$DIST/g" /output/DEBIAN/control
RUN sed -i "s/uv_VERSION/$uv_VERSION/g" /output/DEBIAN/control
RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/g" /output/DEBIAN/control

RUN dpkg-deb --build /output "/$DEB_NAME"
